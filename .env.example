DATABASE_URL=postgresql://unlinked:dev_password@localhost:5432/unlinked
HOST=0.0.0.0
PORT=3000
# Externally visible origin. State-changing requests and WebSocket upgrades
# must come from this origin (dev mode also accepts any localhost origin).
PUBLIC_URL=http://localhost:3000
# Required outside --dev-mode: generate with openssl rand -base64 64.
# Leave unset in dev mode for an ephemeral key; do not set an empty value.
# SESSION_SECRET=
# Or read the secret from a file (one trailing newline is stripped); this keeps
# it out of the process environment. Set SESSION_SECRET or SESSION_SECRET_FILE,
# never both. A missing or short file fails startup, even in dev mode.
# SESSION_SECRET_FILE=/run/secrets/session.key
# Changing the secret ends every session; rotate it to force everyone to sign
# in again (e.g. after a suspected compromise).
SESSION_TTL_DAYS=30
MAX_UPLOAD_BYTES=52428800

# Optional comma-separated allow-list of email domains that may sign in.
# ALLOWED_EMAIL_DOMAINS=example.com,example.org

# OAuth providers: set all three variables to enable one. Outside --dev-mode at
# least one provider is required.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/callback/github
